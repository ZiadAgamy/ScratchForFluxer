# Copy to .env for local development. On Vercel, add the same names under
# Project Settings -> Environment Variables. NEVER commit a real .env file.

# --- Required ---------------------------------------------------------------
# development | production. Vercel counts as production by itself. On your own server set APP_ENV=production, so
# the site refuses to start without its secrets instead of making up a key of its own.
# APP_ENV=production

# Long random string; signs login cookies and encrypts saved bot tokens.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# (Locally you can leave it empty: a key is generated into data/.dev-secret.)
SECRET_KEY=

# Where the site lives: just the address, nothing after the host name (no path, no slash at the end).
# The redirect URI you register in your Fluxer application is this plus /auth/callback, written exactly:
#   https://your-project.vercel.app/auth/callback
# For working on your own computer, register http://localhost:8000/auth/callback as well and open the site at
# http://localhost:8000 (not 127.0.0.1). `python -m scratch_fluxer check` prints the addresses to register.
APP_BASE_URL=http://localhost:8000

# From your Fluxer application: its client ID and its client secret (the secret is private; never commit it).
FLUXER_CLIENT_ID=
FLUXER_CLIENT_SECRET=

# --- Database ---------------------------------------------------------------
# Local default is a SQLite file in ./data. On Vercel use Postgres (Neon via the
# Vercel Marketplace sets DATABASE_URL/POSTGRES_URL for you).
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# --- Bot runner ---------------------------------------------------------------
# Vercel can't keep a bot connected (functions are short-lived), so bots run on a
# separate "runner" service (see deploy/runner/README.md). Locally the site runs
# bots itself, with no setup (RUNNER_MODE=local).
# On the site (Vercel):
# RUNNER_MODE=auto        # auto | local | remote | off
# RUNNER_URL=https://your-runner.example.com   # must be https://
# RUNNER_SECRET=          # at least 32 random characters; the same value on the runner
#
# On the runner (or locally, when the site runs the bots itself):
# RUNNER_MAX_CONCURRENT=8          # bots running at the same time
# RUNNER_MAX_PER_USER=2            # ... per person
# RUNNER_MEMORY_MB=384             # what one bot may hold in memory
# RUNNER_MAX_RUN_SECONDS=21600     # a bot is stopped after this long
# RUNNER_DATA_DIR=                 # where the bots' folders are made (default: ./data/runs)
# RUNNER_UID_BASE=41000            # runner started as root only: every bot gets its own user id from here up

# --- Optional -----------------------------------------------------------------
# Shown on the privacy page so people know how to reach you (https://..., http://... or mailto:...).
# CONTACT_URL=mailto:you@example.com
# A community server for questions and ideas: linked in the footer, at the end of the home page and on the privacy
# page. This is the project's own server. Use your own https:// link, or leave it empty to show no link at all.
# COMMUNITY_URL=https://fluxer.gg/oHy1OzcO

# Behind your own reverse proxy (Caddy, nginx, a load balancer)? The site then has to be told whose address to
# believe, or every visitor looks like the proxy and shares one limit. Not needed on Vercel.
# TRUST_PROXY=1
# TRUSTED_PROXY_HOPS=1   # how many proxies in a row add an address to X-Forwarded-For (a CDN plus a load balancer: 2)

# Changing SECRET_KEY: put the new key in SECRET_KEY and the old one here, run the site, and then
#   python -m scratch_fluxer reencrypt
# (it saves every bot token under the new key). When it says so, remove the old key from here.
# Everybody is logged out once when SECRET_KEY changes: login cookies are signed with it.
# SECRET_KEY_PREVIOUS=

# Limits per person and per bot.
# MAX_BOTS_PER_USER=10
# MAX_ASSETS_PER_BOT=40
# MAX_ASSET_BYTES=2097152          # one uploaded file
# MAX_ASSETS_TOTAL_BYTES=8388608   # all the files of one bot (raise it on the runner as well)
# MAX_WORKSPACE_BYTES=1048576      # the saved blocks of one bot

# Self-hosted Fluxer? Point everything at your instance:
# FLUXER_API_URL=https://api.fluxer.app/v1
# FLUXER_WEB_URL=https://web.fluxer.app
